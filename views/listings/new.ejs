<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h2>Create A New Listing</h2>
    <form method="POST" action="/listings">
        <input type="text" name="listing[title]" placeholder="enter title"><br><br>
        <textarea name="listing[description]">enter description</textarea><br><br>
        <input type="text" name="listing[image]" placeholder="enter image url/link"><br><br>
        <input type="number" name="listing[price]" placeholder="enter price"><br><br>
        <input type="text" name="listing[location]" placeholder="enter location"><br><br>
        <input type="text" name="listing[country]" placeholder="enter country name"><br><br>
        <button type="submit">Add Now</button>
    </form>
</body>
</html>