<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h2>Listing Details :</h2>
    <ul>
        <li><%=foundListing.title%></li>
        <li><%=foundListing.description%></li>
        <li>₹<%=Number(foundListing.price).toLocaleString("en-IN")%></li>
        <li><%=foundListing.location%></li>
        <li><%=foundListing.country%></li>
    </ul>
    <br>
    <a href="/listings/<%=foundListing._id%>/edit">edit listing</a><br><br>
    <form method="POST" action="/listings/<%=foundListing._id%>?_method=DELETE">
        <button>Delete listing</button>
    </form>
</body>
</html>