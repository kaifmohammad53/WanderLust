<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=\, initial-scale=1.0">
    <title>Wanderlust</title>
</head>
<body>
    <h2>Edit your Listing</h2>
    <form method="POST" action="/listings/<%=foundListing._id%>?_method=PUT">
        <input type="text" name="listing[title]" value="<%=foundListing.title%>"><br><br>
        <textarea name="listing[description]"><%=foundListing.description%></textarea><br><br>
        <input type="text" name="listing[image]" value="<%=foundListing.image%>"><br><br>
        <input type="number" name="listing[price]" value="<%=foundListing.price%>"><br><br>
        <input type="text" name="listing[location]" value="<%=foundListing.location%>"><br><br>
        <input type="text" name="listing[country]" value="<%=foundListing.country%>"><br><br>
        <button type="submit">Add Now</button>
    </form>
</body>
</html>